    "Each action can run any command and shows up in the toolbar header.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas acciones pueden ejecutar cualquier comando y se mostrarán en el encabezado."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each action can run any command and shows up in the toolbar header."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces actions peuvent exécuter n’importe quelle commande et s’afficheront dans l’en-tête."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktionen können beliebige Befehle ausführen und erscheinen in der Kopfzeile."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste azioni possono eseguire qualsiasi comando e verranno mostrate nell’intestazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas ações podem executar qualquer comando e aparecerão no cabeçalho."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアクションは任意のコマンドを実行でき、ヘッダーに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些操作可以运行任何命令，并会显示在标题栏中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 모든 명령을 실행할 수 있으며 헤더에 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти действия могут выполнять любые команды и отображаются в заголовке."
          }
        }
      }
    },
