    "Unavailable here until a signed launcher route can reset dependencies with a dry-run report.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible aqui hasta que una ruta de launcher firmada pueda restablecer dependencias con un informe de simulacion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable here until a signed launcher route can reset dependencies with a dry-run report."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponible ici tant qu’une route de lanceur signée ne peut pas réinitialiser les dépendances avec un rapport dry-run."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier nicht verfügbar, bis eine signierte Launcher-Route Abhängigkeiten mit einem Dry-Run-Bericht zurücksetzen kann."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non disponibile qui finché una route del launcher firmata non può reimpostare le dipendenze con un report dry-run."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponível aqui até que uma rota de launcher assinada possa redefinir dependências com um relatório dry-run."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名済みランチャールートがドライランレポート付きで依存関係をリセットできるまで、ここでは利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已签名启动器路由可通过试运行报告重置依赖项之前，此处不可用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명된 런처 경로가 dry-run 보고서와 함께 종속성을 재설정할 수 있을 때까지 여기서는 사용할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
