    "Commands must be 1-32 letters, numbers, or underscores and each published command needs a description.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle müssen 1-32 Buchstaben, Zahlen oder Unterstriche enthalten, und jeder veröffentlichte Befehl benötigt eine Beschreibung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commands must be 1-32 letters, numbers, or underscores and each published command needs a description."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comandos deben tener 1-32 letras, números o guiones bajos, y cada comando publicado necesita una descripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes doivent contenir 1 à 32 lettres, chiffres ou traits de soulignement, et chaque commande publiée nécessite une description."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I comandi devono contenere 1-32 lettere, numeri o trattini bassi e ogni comando pubblicato richiede una descrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドは1～32文字の英字、数字、またはアンダースコアで、公開する各コマンドには説明が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령은 1-32자의 문자, 숫자 또는 밑줄이어야 하며 게시되는 각 명령에는 설명이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os comandos devem ter 1-32 letras, números ou sublinhados, e cada comando publicado precisa de uma descrição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды должны содержать 1-32 буквы, цифры или подчёркивания, и каждой опубликованной команде нужно описание."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令必须包含 1-32 个字母、数字或下划线，并且每个发布的命令都需要描述。"
          }
        }
      }
    },
