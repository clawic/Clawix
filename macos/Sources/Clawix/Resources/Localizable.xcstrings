    "Saved as report %@. Reveal it to attach the bundle to a report whenever you like.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Bericht %@ gespeichert. Zeige ihn im Finder, um das Paket jederzeit an einen Bericht anzuhängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved as report %@. Reveal it to attach the bundle to a report whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado como informe %@. Muéstralo para adjuntar el paquete a un informe cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré comme rapport %@. Affichez-le pour joindre le paquet à un rapport quand vous le souhaitez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato come report %@. Mostralo per allegare il pacchetto a un report quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポート %@ として保存しました。必要なときに表示して、バンドルをレポートに添付できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고서 %@로 저장했습니다. 언제든지 표시해서 번들을 보고서에 첨부할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo como relatório %@. Revele-o para anexar o pacote a um relatório quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено как отчет %@. Откройте его в Finder, чтобы в любой момент приложить пакет к отчету."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存为报告 %@。你可以随时显示它，并将该包附加到报告中。"
          }
        }
      }
    },
