<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Clawix.App.Views.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="640">
      <TextBlock Text="About Clawix" FontSize="22" FontWeight="SemiBold" />
      <TextBlock x:Name="VersionText" />
      <HyperlinkButton Content="Open source license" Click="OpenLicense_Click" />
      <HyperlinkButton Content="Privacy policy" Click="OpenPrivacy_Click" />
      <HyperlinkButton Content="Report an issue" Click="ReportIssue_Click" />
      <Expander Header="Advanced" IsExpanded="False">
        <StackPanel Spacing="12" Padding="0,8,0,0">
          <Button Content="Open log folder" Click="OpenLogs_Click" />
          <Button Content="Run diagnostics" Click="RunDiagnostics_Click" />
          <Button Content="Copy diagnostics report to clipboard" Click="CopyDiagnostics_Click" />
          <TextBlock x:Name="DiagnosticsStatusText" Opacity="0.7" />
          <TextBox x:Name="DiagnosticsReportBox"
                   AcceptsReturn="True"
                   IsReadOnly="True"
                   MinHeight="180"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Page>
