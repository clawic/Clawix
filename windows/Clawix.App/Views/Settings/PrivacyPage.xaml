<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Clawix.App.Views.Settings.PrivacyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="640">
      <TextBlock Text="Privacy" FontSize="22" FontWeight="SemiBold" />
      <ToggleSwitch x:Name="CrashReportsSwitch"
                    Header="Crash reports unavailable"
                    IsEnabled="False"
                    Toggled="CrashReportsSwitch_Toggled" />
      <ToggleSwitch x:Name="TelemetrySwitch"
                    Header="Anonymous telemetry unavailable"
                    IsEnabled="False"
                    Toggled="TelemetrySwitch_Toggled" />
      <ToggleSwitch x:Name="TrainingSwitch"
                    Header="Allow training on conversations"
                    Toggled="TrainingSwitch_Toggled" />
      <TextBlock x:Name="PrivacyStatusText" Opacity="0.7" />
      <Expander Header="Advanced" IsExpanded="False">
        <StackPanel Spacing="12" Padding="0,8,0,0">
          <Button Content="Export all my data..." Click="ExportData_Click" />
          <Button Content="Erase all local data..." Style="{ThemeResource AccentButtonStyle}" Click="EraseData_Click" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Page>
