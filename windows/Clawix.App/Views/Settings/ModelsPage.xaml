<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Clawix.App.Views.Settings.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="640">
      <TextBlock Text="Models" FontSize="22" FontWeight="SemiBold" />
      <ComboBox x:Name="DefaultModelCombo"
                Header="Default model"
                PlaceholderText="Codex Spark"
                SelectionChanged="DefaultModelCombo_SelectionChanged">
        <ComboBoxItem>Codex Spark</ComboBoxItem>
        <ComboBoxItem>Codex Pro</ComboBoxItem>
      </ComboBox>
      <ComboBox x:Name="ReasoningEffortCombo"
                Header="Reasoning effort"
                PlaceholderText="Auto"
                SelectionChanged="ReasoningEffortCombo_SelectionChanged">
        <ComboBoxItem>Auto</ComboBoxItem>
        <ComboBoxItem>Low</ComboBoxItem>
        <ComboBoxItem>Medium</ComboBoxItem>
        <ComboBoxItem>High</ComboBoxItem>
      </ComboBox>
      <Expander Header="Advanced" IsExpanded="False">
        <StackPanel Spacing="12" Padding="0,8,0,0">
          <NumberBox x:Name="TemperatureBox"
                     Header="Temperature"
                     SmallChange="0.1"
                     Minimum="0"
                     Maximum="2"
                     ValueChanged="TemperatureBox_ValueChanged" />
          <NumberBox x:Name="MaxOutputTokensBox"
                     Header="Max output tokens"
                     Minimum="1"
                     ValueChanged="MaxOutputTokensBox_ValueChanged" />
          <ToggleSwitch x:Name="StreamByTokensSwitch"
                        Header="Stream by tokens (off = stream by chunks)"
                        Toggled="StreamByTokensSwitch_Toggled" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Page>
