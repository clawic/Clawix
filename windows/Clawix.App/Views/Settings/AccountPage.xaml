<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Clawix.App.Views.Settings.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="640">
      <TextBlock Text="Account" FontSize="22" FontWeight="SemiBold" />
      <InfoBar x:Name="AccountInfo" IsOpen="True" Severity="Informational" Title="Checking account" Message="Reading local auth state." IsClosable="False" />
      <TextBlock x:Name="ProfileText" TextWrapping="Wrap" Opacity="0.75" />
      <Button x:Name="AuthActionButton" Content="Sign in" Style="{ThemeResource AccentButtonStyle}" Click="AuthAction_Click" />
      <Expander Header="Advanced" IsExpanded="False">
        <StackPanel Spacing="12" Padding="0,8,0,0">
          <Button Content="View access tokens" Click="ViewTokens_Click" />
          <Button Content="Rotate refresh token" Click="RotateRefreshToken_Click" />
          <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.7" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Page>
