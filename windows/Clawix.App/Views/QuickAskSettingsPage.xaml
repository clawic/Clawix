<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Clawix.App.Views.QuickAskSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="640">
      <TextBlock Text="Quick Ask" FontSize="22" FontWeight="SemiBold" />
      <ToggleSwitch x:Name="EnableSwitch" Header="Enable Quick Ask" Toggled="EnableSwitch_Toggled" />
      <TextBox Header="Hotkey" Text="Ctrl + K" IsReadOnly="True" />
      <ToggleSwitch x:Name="SelectedTextSwitch" Header="Include selected text" Toggled="SelectedTextSwitch_Toggled" />
      <ToggleSwitch x:Name="ScreenshotSwitch" Header="Include screenshot" Toggled="ScreenshotSwitch_Toggled" />
    </StackPanel>
  </ScrollViewer>
</Page>
