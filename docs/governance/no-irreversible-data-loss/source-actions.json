{
  "schemaVersion": 1,
  "description": "Clawix-wide destructive/data-moving source classifications. The local no-irreversible-data-loss check scans source files for delete/archive/trash/purge-like operations and requires every match to map to one of these entries or an explicit non-data-loss ignore.",
  "sourceScan": {
    "roots": [
      "macos/Sources",
      "macos/Helpers/Bridged/Sources",
      "ios/Sources",
      "android/app/src",
      "linux/app/src",
      "windows",
      "cli/lib",
      "web/src",
      "packages"
    ],
    "extensions": [
      ".swift",
      ".kt",
      ".ts",
      ".tsx",
      ".js",
      ".mjs",
      ".cs",
      ".sh"
    ],
    "excludePathPatterns": [
      "/.build/",
      "/build/",
      "/node_modules/",
      "/__pycache__/",
      "/web-dist/assets/",
      "BIP39Wordlist.swift$",
      "/Tests/",
      "\\.test\\.(ts|tsx|js|mjs)$"
    ],
    "keywordPattern": "\\b(delete|deleteAll|archive|unarchive|trash|purge|wipe|erase|destroy|rmSync|removeItem|DELETE|DROP)\\b|fs\\.rm|\\.deleteAll\\("
  },
  "ignoredMatches": [
    {
      "id": "visual-icons-copy-and-comments",
      "reason": "Icon names, glyph bridges, explanatory text, and comments that do not execute deletion or data movement.",
      "pathPattern": ".*",
      "linePattern": "(Lucide|TrashIcon|ArchiveIcon|archivebox|FolderOpenIcon|IconChipButton|IconImage\\(\"trash\"|FolderOpenIcon|MenuIconImage|Theme/LucideBridge|LucideBridge|Image\\(systemName|Comment|///|//|\\* |Text\\(|title:|subtitle:|detail:|label:|hint=|return \"|case \\.?(trash|archive)|case \"trash\"|case \"archive\"|\"document\".*\"archive\"|kind: \"archive\"|action: \"archive\"|id: \"archive|static let (delete|archive)|public static let delete|price-drop|removed id|Removed|DiffLineKind|\\.removed|destroy\\(|Delete is intentionally|nothing to delete)"
    },
    {
      "id": "in-memory-listener-or-cache-remove",
      "reason": "In-memory listener sets, render caches, transient dictionaries, or DOM/request bookkeeping; no durable user data is deleted.",
      "pathPattern": ".*",
      "linePattern": "(listeners\\.delete|stateListeners\\.delete|htmlCache\\.delete|delete pending|pending\\[|delete next\\[|inflight\\.remove|activeRequests\\.removeAll|remove\\(key\\)|eventCoalescer\\.reset|stdoutFramer\\.reset|recognizer\\?\\.destroy|socket\\.destroy)"
    },
    {
      "id": "ui-state-reset-or-selection-remove",
      "reason": "Ephemeral UI state, array selection, visual state, or reorder bookkeeping; no durable record is deleted.",
      "pathPattern": ".*",
      "linePattern": "(Color\\.clear|\\.clearContents|selectedIds\\.remove|items\\.remove\\(|entries\\.remove|commandsDraft\\.remove|chips\\.remove|browserTabsLoading\\.remove|expandedReasoning\\.remove|enabledCapabilityIDs\\.remove|removeItem\\(slot|remove\\(at: index\\)|remove\\(at idx|remove\\(at: idx|removeAll \\{ \\$0 ==|removeAll \\{ \\$0\\.id|messagesByChat|reset selection|resetWidget|reset\\(reason|StoreCancellation|DatabaseManagerCancellation|DriveStoreCancellation|MemoryStoreCancellation)"
    },
    {
      "id": "tests-fixtures-and-dump-cleanup",
      "reason": "Test fixture cleanup and generated fixture dump cleanup.",
      "pathPattern": "(windows/scripts/dump-fixtures\\.sh|.*Tests.*)",
      "linePattern": ".*"
    }
  ],
  "classifiedActions": [
    {
      "id": "chat-archive-unarchive",
      "class": "recoverable",
      "policyId": "host-delete-archive-first",
      "targets": ["trash-archive", "local-delete"],
      "status": "verified",
      "confirmation": "ordinary_ui_action",
      "recoveryOrReport": ["archived chat section", "unarchive action", "runtime mirror rollback on failure"],
      "sourcePatterns": [
        { "pathPattern": "(ConversationActions|ArchivesRepository|SidebarThreadProjection|ClawixProtocol|BridgeProtocol|DaemonEngineHost|OpenCodeDaemonEngineHost|clawix-bridge/main|windows/Clawix\\.Bridged|web/src/bridge/store|android/app/src/main/java/.*/chatlist/ChatActionsSheet|ios/Sources/Clawix/Advanced/CommandPalette\\.swift)", "linePattern": "(archive|unarchive|thread/archive|thread/unarchive|archived)" },
        { "pathPattern": "(ContentChrome|SidebarChatContextMenu|SidebarView|Sidebar/)", "linePattern": "(archive|unarchive)" }
      ]
    },
    {
      "id": "local-overrides-reset",
