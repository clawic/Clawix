        { "pathPattern": "(FaviconCache|FirstPaintCache|SnapshotCache|BridgeFixtureExporter|AudioCatalogRegistration|MacControlCenter|ScreenToolService|QuickAskDiag|AndroidSimulatorProcess|IOSSimulatorFramebufferController|LocalModelsRuntime|ClawJSService|ClawJSMacCareClient|DatabaseClient|DatabaseWorkbenchOperations|ReferencesHomeView|ImagePreviewOverlay|EngineHost|DaemonAudioIngest)", "linePattern": "(removeItem|delete\\(\\)|fs\\.rm|DELETE)" }
