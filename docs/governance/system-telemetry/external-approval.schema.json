{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawix.dev/schemas/governance/system-telemetry/external-approval.schema.json",
  "title": "Clawix System Telemetry External Approval Packet",
  "description": "Public-safe exact-run approval packet required before any Clawix system telemetry external lane execution.",
  "x-fixturePath": "docs/governance/system-telemetry/external-approval.fixtures.json",
  "x-validatorPath": "scripts/validate-system-telemetry-external-approval.mjs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "conversationId",
    "planId",
    "repoScope",
    "laneId",
    "approval",
    "preflight",
    "authorization",
    "risk",
    "privacy",
    "closureImpact"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "conversationId": { "const": "019e359b-c0ab-7dc1-ba94-11a49d11dc76" },
    "planId": { "const": "019e3b6c-3dd8-76d2-bf1e-f50a23db7b07-plan" },
    "repoScope": { "const": "clawix-app" },
    "laneId": { "enum": ["CLX-SYS-TEL-EXT-003", "CLX-SYS-TEL-EXT-004", "CLX-SYS-TEL-EXT-005"] },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalId", "decision", "exactRunApproved", "exactRunScope", "approvedBy", "approvedAt", "expiresAt", "approvedActions", "reason"],
      "properties": {
        "approvalId": { "type": "string", "minLength": 1 },
        "decision": { "const": "approved" },
        "exactRunApproved": { "const": true },
        "exactRunScope": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "minLength": 1 },
        "approvedActions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "mustFailClosedBeforeApproval"],
      "properties": {
        "command": { "type": "string", "pattern": "^claw system " },
        "mustFailClosedBeforeApproval": { "const": true }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentialLeaseRefs", "nativeGrantRefs", "networkAccessApproved", "locationGrantRefs", "hardwareProviderRefs", "signedAppRefs"],
      "properties": {
        "credentialLeaseRefs": { "type": "array", "items": { "type": "string" } },
        "nativeGrantRefs": { "type": "array", "items": { "type": "string" } },
        "networkAccessApproved": { "type": "boolean" },
        "locationGrantRefs": { "type": "array", "items": { "type": "string" } },
        "hardwareProviderRefs": { "type": "array", "items": { "type": "string" } },
        "signedAppRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "rollbackOrContinuityPlanRef", "physicalValidationPlanRef", "appMenuValidationPlanRef"],
      "properties": {
        "tier": { "enum": ["provider-live", "sensor-read", "dangerous-control"] },
        "rollbackOrContinuityPlanRef": { "type": "string" },
        "physicalValidationPlanRef": { "type": "string" },
        "appMenuValidationPlanRef": { "type": "string", "minLength": 1 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsSecrets", "preciseLocationApprovedForStorage", "privatePathsIncluded"],
      "properties": {
        "containsSecrets": { "const": false },
        "preciseLocationApprovedForStorage": { "const": false },
        "privatePathsIncluded": { "const": false }
      }
    },
    "closureImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalPendingRows", "requiresEvidencePacket", "requiresFinalSourceReread", "requiresForbiddenNameScan"],
      "properties": {
        "externalPendingRows": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requiresEvidencePacket": { "const": true },
        "requiresFinalSourceReread": { "const": true },
        "requiresForbiddenNameScan": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "laneId": { "const": "CLX-SYS-TEL-EXT-003" } } },
      "then": {
        "properties": {
          "approval": { "properties": { "approvedActions": { "contains": { "const": "physical_sensor_read" } } } },
          "authorization": {
            "properties": {
              "nativeGrantRefs": { "minItems": 1 },
              "hardwareProviderRefs": { "minItems": 1 },
              "signedAppRefs": { "minItems": 1 }
            }
          },
          "risk": { "properties": { "tier": { "const": "sensor-read" } } },
          "closureImpact": { "properties": { "externalPendingRows": { "contains": { "const": "CLX-SYS-TEL-EXT-003" } } } }
        }
      }
    },
    {
      "if": { "properties": { "laneId": { "const": "CLX-SYS-TEL-EXT-004" } } },
      "then": {
        "properties": {
          "approval": { "properties": { "approvedActions": { "contains": { "const": "provider_connection" } } } },
          "authorization": {
            "properties": {
              "credentialLeaseRefs": { "minItems": 1 },
              "networkAccessApproved": { "const": true },
              "locationGrantRefs": { "minItems": 1 },
              "signedAppRefs": { "minItems": 1 }
            }
          },
          "risk": { "properties": { "tier": { "const": "provider-live" } } },
          "closureImpact": { "properties": { "externalPendingRows": { "contains": { "const": "CLX-SYS-TEL-EXT-004" } } } }
        }
      }
    },
    {
      "if": { "properties": { "laneId": { "const": "CLX-SYS-TEL-EXT-005" } } },
      "then": {
        "properties": {
          "approval": { "properties": { "approvedActions": { "contains": { "const": "dangerous_control_execute" } } } },
          "authorization": {
            "properties": {
              "nativeGrantRefs": { "minItems": 1 },
              "signedAppRefs": { "minItems": 1 }
            }
          },
          "risk": {
            "properties": {
              "tier": { "const": "dangerous-control" },
              "rollbackOrContinuityPlanRef": { "minLength": 1 },
              "physicalValidationPlanRef": { "minLength": 1 }
            }
          },
          "closureImpact": { "properties": { "externalPendingRows": { "contains": { "const": "CLX-SYS-TEL-EXT-005" } } } }
        }
      }
    }
  ]
}
