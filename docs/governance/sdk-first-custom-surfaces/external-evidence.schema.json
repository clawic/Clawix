{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawix.dev/schemas/governance/sdk-first-custom-surfaces/external-evidence.schema.json",
  "title": "Clawix SDK-first custom surfaces external evidence packet",
  "description": "Public-safe evidence packet required before replacing an SDK-first custom surfaces EXTERNAL PENDING lane.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "conversationId",
    "goal",
    "laneId",
    "status",
    "runAuthorization",
    "preflight",
    "execution",
    "evidence",
    "redaction",
    "closureImpact",
    "reviewer"
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "laneId": {
      "enum": [
        "CLX-SDK-EXT-001",
        "CLX-SDK-EXT-002",
        "CLX-SDK-EXT-003",
        "CLX-SDK-EXT-004"
      ]
    },
    "publicCompletionRow": {
      "enum": [
        "CLX-SDK-004",
        "CLX-SDK-005",
        "CLX-SDK-008",
        "CLJ-SDK-005",
        "CLJ-SDK-008"
      ]
    },
    "evidenceRefList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "requiredEvidenceRefList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "conversationId": { "const": "019e403c-3837-7f02-9b78-532c43cdd997" },
    "goal": { "const": "sdk-first-custom-surfaces" },
    "laneId": { "$ref": "#/$defs/laneId" },
    "status": { "const": "accepted_external_evidence" },
    "runAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalId", "approvedBy", "approvedAt", "expiresAt", "exactRunScope", "approvedLaneIds"],
      "properties": {
        "approvalId": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "exactRunScope": { "type": "string", "minLength": 1 },
        "approvedLaneIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/laneId" } }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completedAt", "failClosedBeforeApproval", "checks", "resultRefs"],
      "properties": {
        "completedAt": { "type": "string", "format": "date-time" },
        "failClosedBeforeApproval": { "const": true },
        "checks": { "$ref": "#/$defs/requiredEvidenceRefList" },
        "resultRefs": { "$ref": "#/$defs/requiredEvidenceRefList" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "completedAt", "executor", "receiptRefs", "failedApprovedRun"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "executor": {
          "enum": ["signed_host_native", "live_iot_provider", "performance_baseline_review", "marketplace_trust_review"]
        },
        "receiptRefs": { "$ref": "#/$defs/requiredEvidenceRefList" },
        "failedApprovedRun": { "const": false }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auditRefs", "sameMachineEvidenceRefs", "nativeGrantRefs", "providerOrDeviceRefs", "performanceBaselineRefs", "marketplaceTrustRefs", "approvedCriticalFlows", "rollbackOrContinuityRefs"],
      "properties": {
        "auditRefs": { "$ref": "#/$defs/requiredEvidenceRefList" },
        "sameMachineEvidenceRefs": { "$ref": "#/$defs/requiredEvidenceRefList" },
        "nativeGrantRefs": { "$ref": "#/$defs/evidenceRefList" },
        "providerOrDeviceRefs": { "$ref": "#/$defs/evidenceRefList" },
        "performanceBaselineRefs": { "$ref": "#/$defs/evidenceRefList" },
        "marketplaceTrustRefs": { "$ref": "#/$defs/evidenceRefList" },
        "approvedCriticalFlows": { "$ref": "#/$defs/evidenceRefList" },
        "rollbackOrContinuityRefs": { "$ref": "#/$defs/evidenceRefList" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsSecrets", "containsRawCredentials", "containsPrivatePaths", "containsRawTrace", "containsPreciseLocation", "containsDeviceIdentifiers"],
      "properties": {
        "containsSecrets": { "const": false },
        "containsRawCredentials": { "const": false },
        "containsPrivatePaths": { "const": false },
        "containsRawTrace": { "const": false },
        "containsPreciseLocation": { "const": false },
        "containsDeviceIdentifiers": { "const": false }
      }
    },
    "closureImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicRows", "docsToUpdate", "verifiersToRerun", "requiresFinalSourceReread", "requiresUserReviewDecision"],
      "properties": {
        "publicRows": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/publicCompletionRow" } },
        "docsToUpdate": { "$ref": "#/$defs/requiredEvidenceRefList" },
        "verifiersToRerun": { "$ref": "#/$defs/requiredEvidenceRefList" },
        "requiresFinalSourceReread": { "const": true },
        "requiresUserReviewDecision": { "const": true }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewedAt", "reviewedBy", "decision"],
      "properties": {
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewedBy": { "type": "string", "minLength": 1 },
        "decision": { "const": "accepted" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "laneId": { "const": "CLX-SDK-EXT-001" } } },
      "then": {
        "properties": {
          "runAuthorization": {
            "properties": {
              "approvedLaneIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [{ "const": "CLX-SDK-EXT-001" }]
              }
            }
          },
          "execution": { "properties": { "executor": { "const": "signed_host_native" } } },
          "evidence": { "properties": { "nativeGrantRefs": { "$ref": "#/$defs/requiredEvidenceRefList" } } },
          "closureImpact": {
            "properties": {
              "publicRows": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "allOf": [
                  { "contains": { "const": "CLX-SDK-004" } },
                  { "contains": { "const": "CLJ-SDK-005" } }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "laneId": { "const": "CLX-SDK-EXT-002" } } },
      "then": {
        "properties": {
          "runAuthorization": {
            "properties": {
              "approvedLaneIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [{ "const": "CLX-SDK-EXT-002" }]
              }
            }
          },
          "execution": { "properties": { "executor": { "const": "live_iot_provider" } } },
          "evidence": {
            "properties": {
              "providerOrDeviceRefs": { "$ref": "#/$defs/requiredEvidenceRefList" },
              "rollbackOrContinuityRefs": { "$ref": "#/$defs/requiredEvidenceRefList" }
            }
          },
          "closureImpact": {
            "properties": {
              "publicRows": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "allOf": [
                  { "contains": { "const": "CLX-SDK-004" } },
                  { "contains": { "const": "CLJ-SDK-005" } }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "laneId": { "const": "CLX-SDK-EXT-003" } } },
      "then": {
        "properties": {
          "runAuthorization": {
            "properties": {
              "approvedLaneIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [{ "const": "CLX-SDK-EXT-003" }]
              }
            }
          },
          "execution": { "properties": { "executor": { "const": "performance_baseline_review" } } },
          "evidence": {
            "properties": {
              "performanceBaselineRefs": { "$ref": "#/$defs/requiredEvidenceRefList" },
              "approvedCriticalFlows": {
                "type": "array",
                "items": { "$ref": "#/$defs/nonEmptyString" },
                "allOf": [
                  { "contains": { "const": "installed_app_launch" } },
                  { "contains": { "const": "sidebar_hover_click_expand" } },
                  { "contains": { "const": "chat_scroll" } },
                  { "contains": { "const": "composer_typing" } },
                  { "contains": { "const": "route_switching" } },
                  { "contains": { "const": "web_custom_surface_load" } },
                  { "contains": { "const": "swift_custom_surface_load" } },
                  { "contains": { "const": "rescue_reachability" } }
                ]
              }
            }
          },
          "closureImpact": {
            "properties": {
              "publicRows": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "allOf": [
                  { "contains": { "const": "CLX-SDK-008" } },
                  { "contains": { "const": "CLJ-SDK-008" } }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "laneId": { "const": "CLX-SDK-EXT-004" } } },
      "then": {
        "properties": {
          "runAuthorization": {
            "properties": {
              "approvedLaneIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [{ "const": "CLX-SDK-EXT-004" }]
              }
            }
          },
          "execution": { "properties": { "executor": { "const": "marketplace_trust_review" } } },
          "evidence": { "properties": { "marketplaceTrustRefs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/nonEmptyString" } } } },
          "closureImpact": {
            "properties": {
              "publicRows": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [{ "const": "CLX-SDK-005" }]
              }
            }
          }
        }
      }
    }
  ]
}
