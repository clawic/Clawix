{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawix.dev/schemas/supply-chain-security-manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "canonicalSource", "policy", "surfaces"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "canonicalSource": { "const": "../../../clawjs/docs/supply-chain-security.md" },
    "policy": {
      "type": "object",
      "required": ["mode", "releaseHardFail", "sbomFormat", "provenanceTarget", "vulnerabilitySla"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "baseline-plus-release-hard-fail" },
        "releaseHardFail": { "const": true },
        "sbomFormat": { "const": "CycloneDX JSON" },
        "provenanceTarget": { "const": "SLSA Build L2 for CI-built official artifacts" },
        "vulnerabilitySla": {
          "type": "object",
          "required": ["acknowledgeHours", "criticalPlanHours", "criticalFixHours", "highDays", "mediumDays", "lowDays"],
          "additionalProperties": false,
          "properties": {
            "acknowledgeHours": { "const": 48 },
            "criticalPlanHours": { "const": 24 },
            "criticalFixHours": { "const": 72 },
            "highDays": { "const": 7 },
            "mediumDays": { "const": 30 },
            "lowDays": { "const": 90 }
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "status": { "enum": ["pass", "baseline_exception", "external_pending"] },
    "surface": {
      "type": "object",
      "required": ["id", "kind", "path", "releaseCritical", "releaseTargets", "lockfile", "sbom", "provenance", "dependencyReview", "vulnerabilityTriage", "artifactIntegrity", "malwareReview"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
        "kind": { "enum": ["web", "npm-cli", "swiftpm", "tauri", "cargo", "dotnet", "native-app", "bundled-runtime", "release-channel"] },
        "path": { "type": "string", "minLength": 1 },
        "releaseCritical": { "type": "boolean" },
        "releaseTargets": {
          "type": "array",
          "items": { "enum": ["macos-release", "ios-release", "linux-release", "windows-release", "web-release", "all"] },
          "minItems": 1
        },
        "lockfile": { "$ref": "#/$defs/control" },
        "sbom": { "$ref": "#/$defs/control" },
        "provenance": { "$ref": "#/$defs/control" },
        "dependencyReview": { "$ref": "#/$defs/control" },
        "vulnerabilityTriage": { "$ref": "#/$defs/control" },
        "artifactIntegrity": { "$ref": "#/$defs/control" },
        "malwareReview": { "$ref": "#/$defs/control" }
      }
    },
    "evidenceRef": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["path", "command", "hash", "attestation", "capture", "log", "validation"] },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "control": {
      "type": "object",
      "required": ["status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "type": "string", "minLength": 1 },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" },
          "minItems": 1
        },
        "exception": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pass" } }, "required": ["status"] },
          "then": { "required": ["evidenceRefs"] }
        }
      ]
    }
  }
}
