{
  "schemaVersion": 1,
  "program": "macos-ux-trace-harness",
  "status": "contract-defined-pending-implementation",
  "description": "Public-safe schema contract for Clawix macOS UX trace evidence. Private runs may add redacted artifacts, but they must preserve these fields and event types.",
  "evidenceDirectoryShape": [
    "run.json",
    "events.jsonl",
    "metrics.json",
    "failures.json",
    "logs/failure-ui-states.jsonl",
    "captures/",
    "logs/",
    "traces/",
    "fixture-manifest.json",
    "baseline-comparison.json"
  ],
  "suiteDirectoryShape": [
    "suite.json",
    "suite-metrics.json",
    "suite-failures.json",
    "<scenario-run-directories>/"
  ],
  "suiteRequiredFields": [
    "schemaVersion",
    "suiteId",
    "program",
    "suiteName",
    "platform",
    "scenarioCount",
    "startedAt",
    "finishedAt",
    "status",
    "launchMode",
    "instrumentationFlags",
    "privateBoundary",
    "runs",
    "artifactIndex"
  ],
  "runRequiredFields": [
    "schemaVersion",
    "runId",
    "program",
    "scenarioId",
    "fixtureProfile",
    "fixtureSeed",
    "harnessVersion",
    "appBuild",
    "gitSnapshot",
    "platform",
    "osVersion",
    "launchMode",
    "instrumentationFlags",
    "startedAt",
    "finishedAt",
    "status",
    "privateBoundary",
    "artifactIndex"
  ],
  "allowedRunStatuses": [
    "PASS",
    "FAIL",
    "INVALID",
    "BLOCKED",
    "PARTIAL",
    "EXTERNAL_PENDING"
  ],
  "eventRequiredFields": [
    "schemaVersion",
    "runId",
    "scenarioId",
    "fixtureProfile",
    "stepId",
    "actionId",
    "surfaceId",
    "controlId",
    "kpiId",
    "eventType",
    "timestampMonotonicNs",
    "timestampWallClock"
  ],
  "eventTypes": [
    "run.started",
    "fixture.loaded",
    "scenario.started",
    "step.started",
    "action.dispatched",
    "state.changed",
    "visual.condition.met",
    "visual.condition.timeout",
    "geometry.sample",
    "scroll.sample",
    "scroll.anchor.delta",
    "render.mark",
    "render.window",
    "render.invalidated",
    "hitch.sample",
    "resource.sample",
    "database.sample",
    "bridge.sample",
    "stream.delta.received",
    "stream.delta.visible",
    "capture.written",
    "step.completed",
    "step.failed",
    "scenario.completed",
    "run.completed"
  ],
  "metricRequiredFields": [
    "kpiId",
    "priority",
    "surface",
    "sampleCount",
    "unit",
    "p50",
    "p95",
    "p99",
    "worstSample",
    "budget",
    "baseline",
    "regressionPercent",
    "status",
    "evidenceEventRefs"
  ],
  "failureTypes": [
    "product_regression",
    "missing_trace_identity",
    "condition_timeout",
    "geometry_unstable",
    "fixture_invalid",
    "baseline_missing",
    "baseline_regression",
    "instrumentation_error",
    "external_pending",
    "preexisting_unrelated"
  ],
  "failureStateSidecar": {
    "path": "logs/failure-ui-states.jsonl",
    "requiredWhenFinalUIStateExists": true,
    "maxControlsPerState": 200,
    "maxBytesPerRun": 16777216,
    "contentPolicy": "Public artifacts must store redacted UI state only: stable trace surface IDs, enum-like roles/sources, geometry, scroll/resource numbers, booleans, and hashes/lengths for readable strings or dynamic identifiers."
  },
  "privacyRequirements": {
    "publicEvidenceMayContain": [
      "stable IDs",
      "metric names",
      "aggregate values",
      "hashes",
      "relative private aliases",
      "redacted file references"
    ],
    "publicEvidenceMustNotContain": [
      "private conversation text",
      "private conversation titles",
      "readable private screenshots",
      "credentials",
      "signing details",
      "local private paths",
      "real service payloads",
      "raw provider responses"
    ]
  },
  "correlationRequirements": {
    "ids": [
      "runId",
      "scenarioId",
      "fixtureProfile",
      "stepId",
      "actionId",
      "surfaceId",
      "controlId",
      "kpiId"
    ],
    "monotonicClockRequired": true,
    "wallClockRequired": true,
    "dispatchSuccessIsNotVisualSuccess": true
  }
}
