  "fixtureProfiles": [
    { "id": "smoke", "priority": "P0", "scaleIntent": "fast always-runnable harness sanity profile", "requiresCalibration": false },
    { "id": "medium", "priority": "P0", "scaleIntent": "representative daily workload", "requiresCalibration": false },
    { "id": "dense-sidebar", "priority": "P0", "scaleIntent": "many conversations, projects, pinned rows, running states, and row metadata churn", "requiresCalibration": true },
