{
  "schemaVersion": 1,
  "program": "macos-ux-trace-harness",
  "status": "live-p0-runner-available-pending-baseline-approval",
  "platform": "macos",
  "policy": "P0 Clawix macOS UX work must be measurable from agent-control-bus actions to visual completion, geometry, scroll stability, hitches, resources, and approved baseline comparison. Computer Use may witness but must not be the primary measurement dependency.",
  "activationPolicy": {
    "normalAppMode": "high-cardinality trace buffers disabled",
    "harnessMode": "explicit agent instance launch argument or environment only",
    "primaryMeasurementSurface": "agent-control-bus",
    "computerUseDependency": false,
    "mainDatabaseTraceWrites": false,
    "parallelTraceIsolationRequired": true,
    "boundedTraceWriterRequired": true
  },
  "overheadContract": {
    "normalAppHighCardinalityInstrumentation": "disabled unless CLAWIX_AGENT_INSTANCE=1 or an explicit diagnostic flag enables a diagnostic probe",
    "normalAppControlRegistration": "accessibilityIdentifier only; no frame probes, registry writes, control server, fixture mutation, screenshots, or event JSONL writer",
    "harnessEvidenceWrites": "per-run evidence directory outside the main app database; default root is an operating-system temporary directory",
    "eventWriterBounds": {
      "maxEventsPerRun": 100000,
      "maxEventBytesPerRun": 33554432
    },
    "staticVerification": [
      "ClxControlModifier registers probes only under ClxAgentInstance.isAgent",
      "ClxAgentInstance starts the loopback control server only when CLAWIX_AGENT_INSTANCE=1",
      "run_macos_ux_trace_harness writes evidence only to the selected per-run directory",
      "run_macos_ux_trace_harness records mainDatabaseTraceWrites=false in run and suite artifacts"
    ]
  },
  "privateBoundary": {
    "privateEvidenceLocation": "external-private-root",
    "publicArtifactsMayContain": ["schemas", "redacted manifests", "commands", "aliases", "aggregate metric names"],
    "publicArtifactsMustNotContain": ["private conversation text", "readable private screenshots", "credentials", "signing data", "local private paths", "real service payloads"],
    "realEquivalentCalibration": "aggregate metrics only; synthetic profiles must match or exceed private real-mode P95 for P0 flows when calibration evidence is available"
  },
  "requiredArtifacts": {
    "evidenceSchema": "docs/ui/ux-trace-evidence.schema.json",
    "scenarioManifest": "docs/ui/ux-trace-scenarios.manifest.json",
    "calibrationManifest": "docs/ui/ux-trace-calibration.manifest.json",
    "runnerCommand": "node scripts/run_macos_ux_trace_harness.mjs",
    "runnerSelfTestCommand": "node scripts/run_macos_ux_trace_harness.mjs --self-test",
    "suiteRunnerCommand": "node scripts/run_macos_ux_trace_harness.mjs --suite p0",
    "baselineCaptureCommand": "node scripts/run_macos_ux_trace_harness.mjs --write-baseline <file>",
    "p0GateCommand": "node scripts/run_macos_ux_trace_harness.mjs --baseline <file> --gate p0",
    "fixtureGeneratorCommand": "node scripts/generate_macos_ux_trace_fixtures.mjs",
    "fixtureVerificationCommand": "node scripts/scale_lab_fixture_check.mjs",
    "verificationCommand": "node scripts/ui_ux_trace_harness_check.mjs"
  },
  "traceSurfaces": [
