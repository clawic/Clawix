    { "id": "worst-case", "priority": "P0", "scaleIntent": "opt-in stress profile intended to find nonlinear bottlenecks", "requiresCalibration": true },
    { "id": "real-equivalent-private", "priority": "P0", "scaleIntent": "private aggregate calibration profile with no exported private content", "requiresCalibration": true }
