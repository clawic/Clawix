    <string name="app_name">Clawix</string>
    <string name="permission_camera_rationale">Clawix necesita la cámara para escanear el código QR de emparejamiento de tu Mac, capturar fotos para compartir y permitir que el asistente vea a qué apuntas.</string>
    <string name="permission_microphone_rationale">Clawix necesita el micrófono para que puedas dictar prompts y enviar mensajes de voz. El audio se sube a tu Mac emparejado para transcribirlo.</string>
    <string name="permission_local_network_rationale">Clawix necesita descubrir tu Mac en la red local para conectarse al daemon de bridge.</string>
